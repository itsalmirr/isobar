# Binaries
/bin/
/dist/
*.exe
*.test
*.out

# Recorded data — never commit market data or analysis output
/data/
/var/
*.jsonl
*.jsonl.gz

# Backtest CSV outputs are large (~20MB each) and fully regenerable
# from the bin/edge-scan one-liner in the corresponding report. Keep
# the summary .md alongside them committed (small audit trail).
reports/backtest-realized*/edges-*.csv

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local config overrides
config/config.yaml
config/config.local.yaml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Profiles
*.pprof
cpu.prof
mem.prof
trace.out

# Coverage
coverage.out
coverage.html

# Python research pipeline (see docs/RESEARCH_PIPELINE.md / ADR-0006)
research/.venv/
research/__pycache__/
research/**/__pycache__/
research/.ipynb_checkpoints/
research/**/.ipynb_checkpoints/
research/archive/         # locally-cached raw archive data
.python-version           # per-dir pin is enough; allow override
!research/.python-version

# ⚠️ models/ and testdata/ are SOURCE — NOT ignored.
# models/*.json are fitted artifacts consumed by Go at runtime.
# testdata/**/*.json are golden fixtures for cross-language tests.
# Both require review like any other code change.
