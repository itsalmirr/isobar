# Binaries
/bin/
/dist/
*.exe
*.test
*.out

# Recorded data — never commit market data or analysis output
/data/
/var/
*.jsonl
*.jsonl.gz

# Backtest CSV outputs are large (~20MB each) and fully regenerable
# from the bin/edge-scan one-liner in the corresponding report. Keep
# the summary .md alongside them committed (small audit trail).
reports/backtest-realized*/edges-*.csv

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Local config overrides
config/config.yaml
config/config.local.yaml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Profiles
*.pprof
cpu.prof
mem.prof
trace.out

# Coverage
coverage.out
coverage.html
.claude/
