# Kalshi auth — set the key ID, then EITHER inline PEM or file path.
# Both bare names (KALSHI_*) and ISOBAR_-prefixed names are accepted;
# bare matches Kalshi's own naming convention.

KALSHI_API_KEY_ID=

# Option A — inline PEM. Span multiple lines with double quotes:
# KALSHI_PRIVATE_KEY="
# -----BEGIN RSA PRIVATE KEY-----
# MIIEpQIBAAKCAQEA...
# ...
# -----END RSA PRIVATE KEY-----
# "
# (KALSHI_API_KEY is also accepted as a legacy alias for this value.)

# Option B — file path. Recommended for production (chmod 600 the file).
# KALSHI_PRIVATE_KEY_PATH=./secrets/kalshi.pem

# Optional: log level (debug | info | warn | error)
ISOBAR_LOG_LEVEL=info
